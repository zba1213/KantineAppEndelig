@page
@model KantineApp.Pages.OrderModel
@{
    ViewData["Title"] = "Bestil mad";
}
<div class="container">
    <h1>📋 Bestil mad</h1>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success" style="background:#d4edda;padding:12px;border-radius:8px;margin-bottom:20px;">@TempData["SuccessMessage"]</div>
    }
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;">
        <div style="background:white;padding:20px;border-radius:12px;">
            <h2>Din bestilling</h2>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div><label>Medarbejdernummer:</label><input asp-for="EmployeeNumber" /></div>
                <h3>Vælg varer:</h3>
                <div>
                    @for (int i = 0; i < Model.MenuItems.Count; i++)
                    {
                        var item = Model.MenuItems[i];
                        <div style="margin-bottom:10px;">
                            <input type="checkbox" name="SelectedItemIds" value="@item.Id" /> <strong>@item.Name</strong> - @item.Price kr.
                            <input type="number" name="Quantities" value="1" min="1" style="width:60px;" />
                        </div>
                    }
                </div>
                <button type="submit" style="width:100%;padding:12px;background:black;color:white;border-radius:25px;">💰 Bestil</button>
            </form>
        </div>
        <div style="background:white;padding:20px;border-radius:12px;"><h2>ℹ️ Information</h2><p>10% rabat på mad (ikke drikkevarer)</p><p>Bestilling klar om 1 time</p></div>
    </div>
</div>