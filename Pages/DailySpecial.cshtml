@page
@model KantineApp.Pages.DailySpecialModel
@{
    ViewData["Title"] = "Dagens ret";
}
<div class="container">
    <h1>⭐ Dagens ret</h1>
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#d4edda;padding:12px;border-radius:8px;">@TempData["SuccessMessage"]</div>
    }
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;">
        <div style="background:white;padding:20px;border-radius:12px;text-align:center;">
            @if (Model.TodaysSpecial != null)
            {
                <h2>@Model.TodaysSpecial.MenuItem?.Name</h2>
                <p>@Model.TodaysSpecial.MenuItem?.Description</p>

                <h3>@Model.TodaysSpecial.MenuItem?.Price kr.</h3>
            }
            else
            {

                <p>Ingen dagens ret</p>
            }
        </div>
        <div style="background:white;padding:20px;border-radius:12px;">
            <h2>Sæt dagens ret</h2>
            <form method="post">
                <select asp-for="SelectedMenuItemId" style="width:100%;padding:10px;margin-bottom:10px;"><option value="">Vælg ret</option>@foreach (var item in Model.AllMenuItems) {
                <option value="@item.Id">@item.Name</option>
                                }
</select>
                <button type="submit" style="width:100%;padding:12px;background:black;color:white;">Sæt som dagens ret</button>
            </form>
        </div>
    </div>
</div>